# Eko SocialBoard — deployment environment for docker-compose.yml.
# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit `.env` (it is gitignored).
# Compose reads it for ${...} interpolation and passes it to the api / migrate / worker / beat containers.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Local development uses backend/.env instead (see backend/.env.example and docker-compose.dev.yml).

# --- Images (pushed to GHCR by .github/workflows/deploy.yml; omit to build locally) ---
API_IMAGE=ghcr.io/eko-indev-team/eko-social-analytics-api:latest
WEB_IMAGE=ghcr.io/eko-indev-team/eko-social-analytics-web:latest

# --- Database / Redis (private network; not published) ---
POSTGRES_USER=socialboard
POSTGRES_PASSWORD=
POSTGRES_DB=socialboard
REDIS_PASSWORD=

# --- Public URLs (https only in production) ---
# The browser origin of the web app. The API is served on the same origin under /api.
FRONTEND_URL=https://socialboard.example.com
CORS_ORIGINS=https://socialboard.example.com
# Frontend build settings. For /<app-name>/ hosting use matching values, e.g.
# VITE_BASE_PATH=/eko-social-analytics/
# VITE_API_BASE_URL=/eko-social-analytics/api/v1
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api/v1
WEB_PORT=8080
WEB_BIND=127.0.0.1

# --- Security (required; the API refuses to start in production otherwise) ---
SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ENABLE_DOCS=false
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1048576
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
ALLOWED_EMAIL_DOMAINS=eko.co.in

# --- Instagram (leave all empty to keep the integration disabled) ---
# Meta apps created since late 2026 use "Unified login": set INSTAGRAM_CONFIG_ID, and INSTAGRAM_APP_ID/SECRET are the
# *Meta* app ID/secret (App settings > Basic). Redirect URI = https://<your domain>/api/v1/integrations/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_TOKEN_KEY_VERSION=1
# Legacy "Instagram login" apps only:
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_insights

# --- Background sync ---
SYNC_SCHEDULER_ENABLED=true
INSTAGRAM_SYNC_INTERVAL_MINUTES=360
INSTAGRAM_WORKER_CONCURRENCY=2
INSTAGRAM_JOB_MAX_RETRIES=3

# --- AI (AI_PROVIDER=none keeps AI disabled) ---
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MONTHLY_TOKEN_LIMIT=500000
AI_DAILY_REQUEST_LIMIT=500
AI_SCHEDULED_INSIGHTS_ENABLED=false

# --- Ads module (Meta Marketing API; leave the token empty to keep it disabled) ---
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v26.0
META_ADS_ACCOUNT_IDS=
META_ADS_PUBLISH_ACCOUNT_ID=
META_ADS_PAGE_ID=
META_ADS_PIXEL_ID=
META_ADS_WORKSPACE_ID=
META_ADS_SYNC_INTERVAL_MINUTES=60
EKO_SIGNUP_ADMIN_BASE_URL=
EKO_SIGNUP_ADMIN_USER=
EKO_SIGNUP_ADMIN_PASSWORD=
EKO_SIGNUP_ADMIN_VERIFY_TLS=true
AD_STUDIO_IMAGE_PROVIDER=none
